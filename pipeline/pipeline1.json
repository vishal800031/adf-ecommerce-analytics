{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_source_with_parameter",
						"type": "DatasetReference",
						"parameters": {
							"relative_path": {
								"value": "@concat('Bhevendra/ML-Datasets/refs/heads/main/retail_data/',pipeline().parameter.file_name)",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"file_name": {
				"type": "string",
				"defaultValue": "customers.csv"
			},
			"folder_name": {
				"type": "string",
				"defaultValue": "customers"
			}
		},
		"annotations": []
	}
}